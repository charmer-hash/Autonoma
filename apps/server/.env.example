# Server port (Railway sets PORT automatically; default is for local dev)
PORT=8787

# Comma-separated list of allowed origins for CORS, e.g. https://autonoma.pages.dev
CORS_ORIGIN=http://localhost:5173

# Neon Postgres connection string — required, the server persists
# conversation history here and refuses to start without it.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# LLM via OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
# Optional — override the default model if one gets rate-limited/restricted.
# OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# e2b sandbox key
E2B_API_KEY=

# Web search for the agent (https://tavily.com — free tier available)
TAVILY_API_KEY=

# Cloudflare R2 (S3-compatible) — where the agent's export_artifact tool
# uploads generated files (images, PDFs, Excel, etc.) so they survive after
# the per-request sandbox is killed.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Login for the web console — set to require login (leave unset to run
# without auth). Signs the session cookie; accounts themselves live in the
# users table — create one with `pnpm create-user <username> <password>`.
AUTH_SESSION_SECRET=
