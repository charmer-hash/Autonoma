{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"no lint configured\"",
    "db:generate": "drizzle-kit generate",
    "create-user": "tsx --env-file=.env scripts/create-user.ts",
    "configure-r2-lifecycle": "tsx --env-file=.env scripts/configure-r2-lifecycle.ts"
  },
  "dependencies": {
    "@autonoma/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@hono/node-server": "^1.13.7",
    "drizzle-orm": "^0.45.2",
    "e2b": "^2.36.0",
    "hono": "^4.6.14",
    "openai": "^6.49.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
